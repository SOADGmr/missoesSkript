# =============================================================================
# DESERTSKY - MISSÕES 11 A 15: METALURGIA E AGRICULTURA
# Caminho: /plugins/Skript/scripts/Jobs/Missoes/Principais/Explorador/11_a_15_explorador.sk
# =============================================================================

on script load:
    registrarMissao(11, "explorador", 11, "Mestre da Forja", "O ferro é o esqueleto da civilização.", "Minere 15 Ferros e derreta-os na fornalha.")
    registrarMissao(12, "explorador", 12, "Cavaleiro de Ferro", "Proteção e eficiência caminham juntas.", "Crafte o Set de Ferro completo e ferramentas essenciais.")
    registrarMissao(13, "explorador", 13, "Noite de Descanso", "Dormir no chão não é mais uma opção.", "Tosquie 3 ovelhas, crafte e coloque uma cama.")
    registrarMissao(14, "explorador", 14, "Mãos na Terra", "O deserto pode florescer se você for paciente.", "Are 10 blocos de terra e plante 10 sementes de trigo.")
    registrarMissao(15, "explorador", 15, "O Pão Nosso", "Colher o que plantou é a maior das recompensas.", "Colha 10 trigos e crafte 3 pães.")

on mine:
    if metadata "desertsky_placed" of event-block is true:
        stop

    set {_uuid} to uuid of player
    set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
    
    if {_lvl} is 11:
        if event-block is iron ore or deepslate iron ore or raw iron block:
            if {missao::explorador::11::%{_uuid}%::minerado} is not set:
                set {missao::explorador::11::%{_uuid}%::minerado} to 0
            
            if {missao::explorador::11::%{_uuid}%::minerado} < 15:
                add 1 to {missao::explorador::11::%{_uuid}%::minerado}
                set {_m} to {missao::explorador::11::%{_uuid}%::minerado}
                mostrarProgresso(player, "Minerando Ferro", {_m}, 15)
                
                if {_m} is 15:
                    send "&e&l[DIÁRIO] &7Ferro coletado! Agora, &fretire 15 lingotes da fornalha &7após fundir." to player

on inventory click:
    if event-inventory's type is furnace inventory:
        if index of event-slot is 2:
            set {_uuid} to uuid of player
            set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
            
            if {_lvl} is 11:
                if event-item is iron ingot:
                    if {missao::explorador::11::%{_uuid}%::minerado} >= 15:
                        if {missao::explorador::11::%{_uuid}%::derretido} is not set:
                            set {missao::explorador::11::%{_uuid}%::derretido} to 0
                        
                        set {_qtd} to item amount of event-item
                        add {_qtd} to {missao::explorador::11::%{_uuid}%::derretido}
                        set {_d} to {missao::explorador::11::%{_uuid}%::derretido}
                        
                        mostrarProgresso(player, "Coletando Lingotes", {_d}, 15)
                        
                        if {_d} >= 15:
                            delete {missao::explorador::11::%{_uuid}%::*}
                            concluirMissaoPrincipal(player, 11, "explorador", 12)

on craft:
    set {_uuid} to uuid of player
    set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
    
    if {_lvl} is 12:
        set {_req::*} to iron helmet, iron chestplate, iron leggings, iron boots, iron pickaxe, iron axe, iron shovel, iron hoe, iron sword, shears and bucket
        
        if {_req::*} contains event-item:
            set {_item} to "%event-item%"
            if {missao::explorador::12::%{_uuid}%::crafts::*} does not contain {_item}:
                add {_item} to {missao::explorador::12::%{_uuid}%::crafts::*}
                set {_total} to size of {missao::explorador::12::%{_uuid}%::crafts::*}
                
                mostrarProgresso(player, "Equipamento de Ferro", {_total}, 11)
                
                if {_total} >= 11:
                    delete {missao::explorador::12::%{_uuid}%::*}
                    concluirMissaoPrincipal(player, 12, "explorador", 13)

on right click on sheep:
    if player's tool is shears:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 13:
            if target entity is not sheared:
                if {missao::explorador::13::%{_uuid}%::tosquia} is not set:
                    set {missao::explorador::13::%{_uuid}%::tosquia} to 0
                    
                if {missao::explorador::13::%{_uuid}%::tosquia} < 3:
                    add 1 to {missao::explorador::13::%{_uuid}%::tosquia}
                    set {_t} to {missao::explorador::13::%{_uuid}%::tosquia}
                    mostrarProgresso(player, "Tosquiando Ovelhas", {_t}, 3)
                    
                    if {_t} is 3:
                        send "&e&l[DIÁRIO] &7Lã obtida! Agora &fcrafte uma cama &7e coloque-a no chão." to player

on place:
    set {_uuid} to uuid of player
    set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
    
    if {_lvl} is 13:
        if event-block is white bed, orange bed, magenta bed, light blue bed, yellow bed, lime bed, pink bed, gray bed, light gray bed, cyan bed, purple bed, blue bed, brown bed, green bed, red bed or black bed:
            if {missao::explorador::13::%{_uuid}%::tosquia} >= 3:
                delete {missao::explorador::13::%{_uuid}%::*}
                concluirMissaoPrincipal(player, 13, "explorador", 14)

on right click on grass block or dirt:
    set {_tool} to player's tool
    if {_tool} is wooden hoe, stone hoe, iron hoe, golden hoe, diamond hoe or netherite hoe:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 14:
            if {missao::explorador::14::%{_uuid}%::arado} is not set:
                set {missao::explorador::14::%{_uuid}%::arado} to 0
            
            if {missao::explorador::14::%{_uuid}%::arado} < 10:
                wait 1 tick
                if block at event-block is farmland:
                    add 1 to {missao::explorador::14::%{_uuid}%::arado}
                    mostrarProgresso(player, "Preparando o Solo", {missao::explorador::14::%{_uuid}%::arado}, 10)
                    
                    if {missao::explorador::14::%{_uuid}%::arado} is 10:
                        send "&e&l[DIÁRIO] &7Solo pronto! Agora &fplante 10 sementes de trigo&7." to player

on place:
    if event-block is wheat:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 14:
            if {missao::explorador::14::%{_uuid}%::arado} >= 10:
                if {missao::explorador::14::%{_uuid}%::plantado} is not set:
                    set {missao::explorador::14::%{_uuid}%::plantado} to 0
                
                add 1 to {missao::explorador::14::%{_uuid}%::plantado}
                set {_p} to {missao::explorador::14::%{_uuid}%::plantado}
                mostrarProgresso(player, "Semeando Trigo", {_p}, 10)
                
                if {_p} >= 10:
                    delete {missao::explorador::14::%{_uuid}%::*}
                    concluirMissaoPrincipal(player, 14, "explorador", 15)

on break of wheat:
    set {_uuid} to uuid of player
    set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
    
    if {_lvl} is 14:
        if {missao::explorador::14::%{_uuid}%::plantado} > 0:
            remove 1 from {missao::explorador::14::%{_uuid}%::plantado}
            mostrarProgresso(player, "Semente Perdida", {missao::explorador::14::%{_uuid}%::plantado}, 10)

on block break:
    if "%event-block%" contains "wheat":
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 15:
            if "%block data of event-block%" contains "age=7":
                if {missao::explorador::15::%{_uuid}%::colhido} is not set:
                    set {missao::explorador::15::%{_uuid}%::colhido} to 0
                
                if {missao::explorador::15::%{_uuid}%::colhido} < 10:
                    add 1 to {missao::explorador::15::%{_uuid}%::colhido}
                    set {_c} to {missao::explorador::15::%{_uuid}%::colhido}
                    mostrarProgresso(player, "Colhendo Trigo", {_c}, 10)
                    
                    if {_c} is 10:
                        send "" to player
                        send "&e&l[DIÁRIO] &7Trigo colhido! Agora vá até a bancada e &fcrafte 3 Pães&7." to player
                        play sound "entity.experience_orb.pickup" to player

on inventory click:
    set {_tipo_inv} to "%type of event-inventory%"
    if {_tipo_inv} contains "workbench" or "crafting":
        if index of event-slot is 0:
            if event-item is bread:
                set {_uuid} to uuid of player
                set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
                
                if {_lvl} is 15:
                    if {missao::explorador::15::%{_uuid}%::colhido} >= 10:
                        set {_click} to "%click type%"
                        if {_click} contains "SHIFT" or "NUMBER" or "DROP":
                            cancel event
                            set {temp_block_craft::%{_uuid}%} to true
                            send "&c&l[!] &cPor favor, recolha os pães com cliques normais do rato (Sem atalhos numéricos ou shift) para contar corretamente!" to player
                            play sound "entity.villager.no" to player

on craft:
    if event-item is bread:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 15:
            if {temp_block_craft::%{_uuid}%} is true:
                delete {temp_block_craft::%{_uuid}%}
                stop
                
            if {missao::explorador::15::%{_uuid}%::colhido} >= 10:
                if {missao::explorador::15::%{_uuid}%::paes} is not set:
                    set {missao::explorador::15::%{_uuid}%::paes} to 0
                
                add 1 to {missao::explorador::15::%{_uuid}%::paes}
                set {_p} to {missao::explorador::15::%{_uuid}%::paes}
                
                mostrarProgresso(player, "Preparando Pães", {_p}, 3)
                
                if {_p} >= 3:
                    delete {missao::explorador::15::%{_uuid}%::*}
                    concluirMissaoPrincipal(player, 15, "explorador", 16)
            else:
                send "&c[!] Você precisa colher 10 trigos maduros primeiro!" to player