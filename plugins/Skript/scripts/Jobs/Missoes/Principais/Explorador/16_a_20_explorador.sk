# =============================================================================
# DESERTSKY - MISSÕES 16 A 20: A FRONTEIRA FINAL
# Caminho: /plugins/Skript/scripts/Jobs/Missoes/Principais/Explorador/16_a_20_explorador.sk
# =============================================================================

on script load:
    registrarMissao(16, "explorador", 16, "A Teia do Caçador", "Para pescar, precisas de linhas.", "Mate 5 Aranhas e crafte 1 Vara de Pesca.")
    registrarMissao(17, "explorador", 17, "O Pescador Solitário", "A água do oásis esconde segredos.", "Pesque 3 peixes com sucesso.")
    registrarMissao(18, "explorador", 18, "Limites do Território", "Protege a tua casa dos perigos externos.", "Crafte e instale 20 cercas de madeira.")
    registrarMissao(19, "explorador", 19, "Brilho nas Profundezas", "O ápice da tua jornada como explorador.", "Encontre e minere 1 Minério de Diamante.")
    registrarMissao(20, "explorador", 20, "A Grande Decisão", "O deserto agora é pequeno para ti.", "Abre o /diario e escolhe a tua profissão no Guia de Trabalhos!")

on death of spider or cave spider:
    attacker is a player
    set {_uuid} to uuid of attacker
    set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
    
    if {_lvl} is 16:
        if {missao::explorador::16::%{_uuid}%::kills} is not set:
            set {missao::explorador::16::%{_uuid}%::kills} to 0
        
        if {missao::explorador::16::%{_uuid}%::kills} < 5:
            add 1 to {missao::explorador::16::%{_uuid}%::kills}
            set {_k} to {missao::explorador::16::%{_uuid}%::kills}
            mostrarProgresso(attacker, "Caçando Aranhas", {_k}, 5)
            
            if {_k} is 5:
                send "" to attacker
                send "&e&l[DIÁRIO] &7Fios recolhidos! Agora vai à bancada e &fcrafte 1 Vara de Pesca&7." to attacker
                play sound "entity.experience_orb.pickup" to attacker

on craft:
    if event-item is fishing rod:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 16:
            if {missao::explorador::16::%{_uuid}%::kills} >= 5:
                delete {missao::explorador::16::%{_uuid}%::*}
                concluirMissaoPrincipal(player, 16, "explorador", 17)
            else:
                send "&c[!] Precisas de caçar as aranhas primeiro!" to player

on fishing state change:
    if event-fishing state is fish caught:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 17:
            if {missao::explorador::17::%{_uuid}%::peixes} is not set:
                set {missao::explorador::17::%{_uuid}%::peixes} to 0
            
            if {missao::explorador::17::%{_uuid}%::peixes} < 3:
                add 1 to {missao::explorador::17::%{_uuid}%::peixes}
                set {_p} to {missao::explorador::17::%{_uuid}%::peixes}
                mostrarProgresso(player, "Pescando", {_p}, 3)
                
                if {_p} >= 3:
                    delete {missao::explorador::17::%{_uuid}%::*}
                    concluirMissaoPrincipal(player, 17, "explorador", 18)

on inventory click:
    set {_tipo_inv} to "%type of event-inventory%"
    if {_tipo_inv} contains "workbench" or "crafting":
        if index of event-slot is 0:
            if type of event-item is oak fence or spruce fence or birch fence or jungle fence or acacia fence or dark oak fence or mangrove fence or cherry fence:
                set {_uuid} to uuid of player
                set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
                
                if {_lvl} is 18:
                    set {_click} to "%click type%"
                    if {_click} contains "SHIFT" or "NUMBER" or "DROP":
                        cancel event
                        set {temp_block_craft::%{_uuid}%} to true
                        send "&c&l[!] &cPor favor, recolha as cercas com cliques normais do rato (Sem atalhos numéricos ou shift) para contar corretamente!" to player
                        play sound "entity.villager.no" to player

on craft:
    if type of event-item is oak fence or spruce fence or birch fence or jungle fence or acacia fence or dark oak fence or mangrove fence or cherry fence:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 18:
            if {temp_block_craft::%{_uuid}%} is true:
                delete {temp_block_craft::%{_uuid}%}
                stop
                
            if {missao::explorador::18::%{_uuid}%::craftadas} is not set:
                set {missao::explorador::18::%{_uuid}%::craftadas} to 0
            
            if {missao::explorador::18::%{_uuid}%::craftadas} < 20:
                set {_amount} to item amount of event-item
                add {_amount} to {missao::explorador::18::%{_uuid}%::craftadas}
                set {_c} to {missao::explorador::18::%{_uuid}%::craftadas}
                mostrarProgresso(player, "Fabricando Cercas", {_c}, 20)
                
                if {_c} >= 20:
                    send "" to player
                    send "&e&l[DIÁRIO] &7Cercas prontas! Agora &finstala 20 cercas &7para delimitar o terreno." to player
                    play sound "entity.experience_orb.pickup" to player

on place:
    if event-block is oak fence, spruce fence, birch fence, jungle fence, acacia fence, dark oak fence, mangrove fence or cherry fence:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 18:
            if {missao::explorador::18::%{_uuid}%::craftadas} >= 20:
                if {missao::explorador::18::%{_uuid}%::colocadas} is not set:
                    set {missao::explorador::18::%{_uuid}%::colocadas} to 0
                
                add 1 to {missao::explorador::18::%{_uuid}%::colocadas}
                set {_c} to {missao::explorador::18::%{_uuid}%::colocadas}
                mostrarProgresso(player, "Instalando Cercas", {_c}, 20)
                
                if {_c} >= 20:
                    delete {missao::explorador::18::%{_uuid}%::*}
                    concluirMissaoPrincipal(player, 18, "explorador", 19)

on block break:
    if event-block is oak fence, spruce fence, birch fence, jungle fence, acacia fence, dark oak fence, mangrove fence or cherry fence:
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 18:
            if {missao::explorador::18::%{_uuid}%::colocadas} > 0:
                remove 1 from {missao::explorador::18::%{_uuid}%::colocadas}
                mostrarProgresso(player, "Cerca Danificada", {missao::explorador::18::%{_uuid}%::colocadas}, 20)

on mine:
    if event-block is diamond ore or deepslate diamond ore:
        if metadata "desertsky_placed" of event-block is true:
            stop
            
        set {_uuid} to uuid of player
        set {_lvl} to {nivel::explorador::%{_uuid}%} ? 1
        
        if {_lvl} is 19:
            concluirMissaoPrincipal(player, 19, "explorador", 20)
            
            wait 2 seconds
            send title "&b&lMOMENTO ÉPICO!" with subtitle "&7Encontraste o teu primeiro diamante." to player for 5 seconds
            play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 0.8 to player
            
            send "" to player
            send "&6&l[!] &eAlcançaste o &fNível 20 &ede Explorador!" to player
            send "&6&l[!] &eChegou a hora de decidir o teu futuro." to player
            send "&6&l[!] &eAbre o teu &f/diario &ee clica na &fEstrela do Nether &epara escolheres uma profissão." to player
            send "" to player