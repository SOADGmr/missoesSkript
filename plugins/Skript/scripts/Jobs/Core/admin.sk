# =============================================================================
# DESERTSKY - CLI ADMINISTRATIVA (V5.3 - SINCRONIA TOTAL DE PROGRESSO)
# Caminho: /plugins/Skript/scripts/Jobs/core/Admin.sk
# =============================================================================

command /jobadmin [<text>] [<offline player>] [<text>] [<integer>]:
    usage: Um comando usado por administradores para gerenciar dados do jogador
    permission: desertsky.jobs.admin
    permission message: &c[!] Acesso negado. Requer permissao 'desertsky.jobs.admin'.
    trigger:
        if arg 1 is not set:
            send "&8&l--- &6DesertSky Jobs Admin CLI v5.3 &8&l---"
            send "&e/jobadmin &cstatus &f<jogador> &7- Visão geral dos Jobs."
            send "&e/jobadmin &cinspect &f<jogador> &7- Abre GUI com histórico de missões."
            send "&e/jobadmin &csetnivel &f<jogador> <profissão> <nivel> &7- Altera o nível do Job."
            send "&e/jobadmin &cemploy &f<jogador> <profissão> &7- Contrata (Ignora Requisitos)."
            send "&e/jobadmin &cfire &f<jogador> <profissão> &7- Demite o jogador do Job."
            send "&e/jobadmin &creset &f<jogador> <profissão> <id> &7- Reseta missão."
            send "&e/jobadmin &cforcecomplete &f<jogador> <profissão> <id> &7- Força conclusão."
            send "&e/jobadmin &cskipday &f<jogador> &7- Simula passagem de dia."
            stop

        if arg 2 is not set:
            send "&c[!] Especifique um jogador:"
            send " &7/jobadmin %arg-1% &e<jogador> &7<profissao>"
            stop

        set {_p} to arg 2
        set {_uuid} to uuid of {_p}

        # 1. STATUS GLOBAL
        if arg 1 is "status":
            set {_jobs_lista::*} to jobs of {_p}
            
            if size of {_jobs_lista::*} > 0:
                loop {_jobs_lista::*}:
                    add "%loop-value%" to {_nomes_jobs::*}
                set {_job_atual} to join {_nomes_jobs::*} with ", "
            else:
                set {_job_atual} to "Nenhuma"
            
            send "&8&l-------- &6STATUS: %{_p}% &8&l--------"
            send "&eProfissões (Jobs): &f%{_job_atual}%"
            
            set {_lvl_exp} to {nivel::explorador::%{_uuid}%} ? {nivel::%{_uuid}%} ? 1
            send "&eNível Explorador: &f%{_lvl_exp}%"
            
            if size of {_nomes_jobs::*} > 0:
                loop {_nomes_jobs::*}:
                    set {_nome_job} to loop-value
                    set {_job_id} to {_nome_job} in lowercase

            send "&eÚltimo Reset (Data): &f%{last_reset::%{_uuid}%}%"
            send "&8&l-------------------------------"

        # 2. SETNIVEL (Com Sincronização Total de Histórico)
        else if arg 1 is "setnivel":
            if arg 3 is not set:
                send "&c[!] Especifique o job (ex: explorador, minerador)."
                stop
            if arg 4 is not set:
                send "&c[!] Especifique o nível numérico."
                stop
                
            set {_job} to arg 3 in lowercase
            set {_novo_nivel} to arg 4
            
            # Altera o nível base e sincroniza com o JobsReborn
            setNivelJob({_p}, {_job}, {_novo_nivel})
            
            # Sincroniza o banco de dados de Missões!
            # Marca todas as missões anteriores como "concluídas" e reseta as futuras
            loop 100 times:
                if loop-number < {_novo_nivel}:
                    set {missao::%{_job}%::%loop-number%::%{_uuid}%::status} to "concluida"
                else:
                    delete {missao::%{_job}%::%loop-number%::%{_uuid}%::status}
                    delete {missao::%{_job}%::%loop-number%::%{_uuid}%::progresso}
                
            send "&a[!] O Nível de %{_job}% de %{_p}% foi alterado para %{_novo_nivel}%."
            send "&a[!] O histórico de missões foi sincronizado automaticamente com o novo nível."

        # 3. FORÇAR CONTRATAÇÃO
        else if arg 1 is "employ":
            if arg 3 is not set:
                send "&c[!] Especifique o job que deseja forçar a contratação."
                stop
                
            set {_job} to arg 3 in lowercase
            execute console command "jobs employ %{_p}% %{_job}%"
            send "&a[!] O jogador %{_p}% foi contratado como %{_job}% ignorando requisitos."

        # 4. DEMISSÃO (FIRE)
        else if arg 1 is "fire":
            if arg 3 is not set:
                send "&c[!] Especifique o job que deseja demitir o jogador."
                stop
                
            set {_job} to arg 3 in lowercase
            demitirJob({_p}, {_job})
            send "&a[!] Pedido de demissão enviado. O Skript fará a limpeza automática dos dados."

        # 5. RESET DE MISSÃO ESPECÍFICA
        else if arg 1 is "reset":
            if arg 3 is not set:
                send "&c[!] Especifique o job."
                stop
            if arg 4 is not set:
                send "&c[!] Especifique o ID da Missão."
                stop
                
            set {_job} to arg 3 in lowercase
            delete {missao::%{_job}%::%arg 4%::%{_uuid}%::status}
            delete {missao::%{_job}%::%arg 4%::%{_uuid}%::progresso}
            
            send "&a[!] A missão %arg 4% (%{_job}%) do jogador %{_p}% foi resetada."

        # 6. FORCE COMPLETE
        else if arg 1 is "forcecomplete":
            if arg 3 is not set:
                send "&c[!] Especifique o job."
                stop
            if arg 4 is not set:
                send "&c[!] Especifique o ID da Missão."
                stop
            
            set {_job} to arg 3 in lowercase
            set {_id} to arg 4
            set {_prox_nivel} to {_id} + 1
            
            concluirMissaoPrincipal({_p}, {_id}, {_job}, {_prox_nivel})
            send "&a[!] Missão %{_id}% (%{_job}%) do jogador %{_p}% forçada para CONCLUÍDA com sucesso."

        # 7. SKIPDAY
        else if arg 1 is "skipday":
            set {last_reset::%{_uuid}%} to "01/01/1990"
            send "&a[!] Data de %{_p}% revertida. Lazy Reset engatilhado."

        # 8. INSPECT GUI
        else if arg 1 is "inspect":
            set {_gui} to a new chest inventory with 6 rows named "&8&lInspect: %{_p}%"
            loop 54 times:
                set slot (loop-number - 1) of {_gui} to black stained glass pane named " "
            
            set {_lvl_exp} to {nivel::explorador::%{_uuid}%} ? 1
            set slot 4 of {_gui} to player head named "&6&l%{_p}%" with lore "&7Nível Explorador: &f%{_lvl_exp}%", "" and "&8Monitoramento em tempo real."
            
            set {_slot} to 10
            loop 20 times:
                if loop-number is less than {_lvl_exp}:
                    set slot {_slot} of {_gui} to lime dye named "&aMissão %loop-number%" with lore "&7Status: &aConcluída"
                else if loop-number is {_lvl_exp}:
                    set slot {_slot} of {_gui} to yellow dye named "&eMissão %loop-number%" with lore "&7Status: &eEm Andamento"
                else:
                    set slot {_slot} of {_gui} to gray dye named "&cMissão %loop-number%" with lore "&7Status: &cBloqueada"
                
                add 1 to {_slot}
                if {_slot} is 17:
                    set {_slot} to 19
                else if {_slot} is 26:
                    set {_slot} to 28
                    
            open {_gui} to player

on inventory click:
    if name of event-inventory contains "&8&lInspect:":
        cancel event