# ========================================================================
# MOTOR DE MISSÕES SEMANAIS - DESERTSKY (V5.6 - SUPER OTIMIZADO)
# Arquivo: gerador_semanais.sk
# ========================================================================

on load:
    registrarNPC(11, "Almoxarife") # Minerador
    registrarNPC(21, "Almoxarife") # Lenhador
    registrarNPC(31, "Almoxarife") # Escavador
    registrarNPC(41, "Almoxarife") # Fazendeiro
    registrarNPC(51, "Almoxarife") # Pescador
    registrarNPC(61, "Almoxarife") # Construtor
    registrarNPC(71, "Almoxarife") # Bruxo
    registrarNPC(81, "Almoxarife") # Mago
    
    send "&e[DesertSky-Jobs] &aMotor Semanal V5.6 carregado com FILTRO DE NÍVEIS!" to console

# ========================================================================
# MOTOR DE RESET SEMANAL (LAZY RESET COM API DO CORE)
# ========================================================================
on join:
    wait 5 seconds
    set {_uuid} to uuid of player
    set {_semana_atual} to now formatted as "ww/yyyy"
    
    if {last_semanal_reset::%{_uuid}%} is not {_semana_atual}:
        set {last_semanal_reset::%{_uuid}%} to {_semana_atual}
        play sound "entity.player.levelup" with volume 0.5 and pitch 0.8 to player
        
        set {_ativos::*} to getJobsAtivos(player)
        loop {_ativos::*}:
            sortearSemanal(player, loop-value)

# ========================================================================
# FUNÇÕES DE REGISTRO E COMPILAÇÃO
# ========================================================================
function registrarMetaBase(id: text, acao: text, tipos_str: text, nome_curto: text, desc: text):
    set {meta_base::%{_id}%::acao} to {_acao}
    set {meta_base::%{_id}%::nome_curto} to {_nome_curto}
    set {meta_base::%{_id}%::desc} to {_desc}
    set {_tipos::*} to {_tipos_str} split at ","
    delete {meta_base::%{_id}%::tipos::*}
    loop {_tipos::*}:
        add loop-value to {meta_base::%{_id}%::tipos::*}

function addMetaSemanal(id_contrato: text, id_meta: text, min: number, max: number):
    add "%{_id_meta}%|%{_min}%|%{_max}%" to {semanal_meta::%{_id_contrato}%::metas_raw::*}

function sortearSemanal(p: player, job: text):
    set {_tamanho} to size of {pool_semanal::%{_job}%::*}
    if {_tamanho} is 0:
        stop

  # --- NOVO SISTEMA DE FILTRO DE NÍVEL (LAZY FILTERING) ---
    set {_lvl} to getNivelJob({_p}, {_job})
    delete {_pool_valido::*}
    
    loop {pool_semanal::%{_job}%::*}:
        set {_id_contrato} to loop-value
        set {_n_min} to {semanal_meta::%{_id_contrato}%::nivel_min} ? 1
        set {_n_max} to {semanal_meta::%{_id_contrato}%::nivel_max} ? 100
        
        if {_lvl} is between {_n_min} and {_n_max}:
            add {_id_contrato} to {_pool_valido::*}
            
    if size of {_pool_valido::*} is 0:
        send "&c[Sindicato] Não temos contratos semanais de %{_job}% para o teu nível atual." to {_p}
        stop

    # Sorteia apenas entre as missões válidas para o nível do jogador
    set {_contrato_id} to a random element out of {_pool_valido::*}
    # -----------------------------------------------------------------
    
  # --- FÓRMULA DE PAGAMENTO SEMANAL ---
    if {_lvl} < 100:
        set {_percent_semanal2} to 0.25*0.30
        set {_ajuste2} to 1.6875
        set {_percent_semanal3} to 0.35*0.30
        set {_ajuste3} to 2.3625
    else:
        set {_percent_semanal2} to 0.35*0.50
        set {_ajuste2} to 3.9375
        set {_percent_semanal3} to 0.45*0.50
        set {_ajuste3} to 5.0625
    
    if {_job} is "bruxo" or "mago":
        set {_money} to (({salario}*{_percent_semanal3})/4) + ({_ajuste3}*{_lvl})
    else:
        set {_money} to (({salario}*{_percent_semanal2})/4) + ({_ajuste2}*{_lvl})
        
    set {missao::semanal::%{_p}%::%{_job}%::recompensa_dinheiro} to {_money}
  # --- SALVA DADOS DA MISSÃO NO BANCO DE DADOS DO JOGADOR ---
    set {missao::semanal::%{_p}%::%{_job}%::id} to {_contrato_id}
    set {missao::semanal::%{_p}%::%{_job}%::status} to "em_andamento"

  # --- LIMPEZA PROFUNDA ---
    delete {missao::semanal::%{_p}%::%{_job}%::meta::*}
    delete {missao::semanal::%{_p}%::%{_job}%::acao_ativa::*}

    loop 20 times:
        delete {missao::semanal::%{_p}%::%{_job}%::meta::%loop-number%::id}
        delete {missao::semanal::%{_p}%::%{_job}%::meta::%loop-number%::alvo}
        delete {missao::semanal::%{_p}%::%{_job}%::meta::%loop-number%::progresso}
  # ---
    set {_meta_index} to 1
    loop {semanal_meta::%{_contrato_id}%::metas_raw::*}:
        set {_parts::*} to loop-value split at "|"
        set {_meta_id} to {_parts::1}
        set {_min} to {_parts::2} parsed as number
        set {_max} to {_parts::3} parsed as number
        
        set {_acao_necessaria} to {meta_base::%{_meta_id}%::acao}
        set {missao::semanal::%{_p}%::%{_job}%::acao_ativa::%{_acao_necessaria}%} to true
        
        set {_alvo_sorteado} to a random integer between {_min} and {_max}
        
        set {missao::semanal::%{_p}%::%{_job}%::meta::%{_meta_index}%::id} to {_meta_id}
        set {missao::semanal::%{_p}%::%{_job}%::meta::%{_meta_index}%::alvo} to {_alvo_sorteado}
        set {missao::semanal::%{_p}%::%{_job}%::meta::%{_meta_index}%::progresso} to 0
        
        add 1 to {_meta_index}

  # --- MENSAGEM DE RECEBIMENTO DO CONTRATO ---
    send "" to {_p}
    send "&7--------------------------------------------------" to {_p}
    send "&7ɴᴏᴠᴏ &6&lᴄᴏɴᴛʀᴀᴛᴏ sᴇᴍᴀɴᴀʟ &7ᴅᴇ %formatarNomeJob({_job})% &7ᴅɪsᴘᴏɴɪᴠᴇʟ!" to {_p}
    send "" to {_p}
    send "&7ᴍɪssᴀᴏ: &f%{semanal_meta::%{_contrato_id}%::nome}%" to {_p}
    send "&7ᴀʙʀᴀ ᴀ &eᴄᴇɴᴛʀᴀʟ ᴅᴇ ᴄᴏɴᴛʀᴀᴛᴏs &7ᴘᴀʀᴀ ᴠᴇʀ ᴏs ᴏʙᴊᴇᴛɪᴠᴏs." to {_p}
    send "&7--------------------------------------------------" to {_p}
    send "" to {_p}

function formatarLoreSemanal(p: player, job: text) :: texts:
    set {_contrato_id} to {missao::semanal::%{_p}%::%{_job}%::id}
    set {_desc_base} to {semanal_meta::%{_contrato_id}%::desc}
    
    set {_lore::*} to {_desc_base} split at "|"
    add "" to {_lore::*}
    add "&f&lᴏʙᴊᴇᴛɪᴠᴏs:" to {_lore::*}

    set {_index} to 1
    while {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::id} is set:
        set {_meta_id} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::id}
        set {_alvo} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::alvo}
        set {_progresso} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::progresso}
        
        set {_desc_meta} to {meta_base::%{_meta_id}%::desc}
        replace all "@alvo@" with "%{_alvo}%" in {_desc_meta}
        
        if {_progresso} >= {_alvo}:
            add "&8[&a&l✔&8] &a%{_desc_meta}% &8(%{_progresso}%/%{_alvo}%)" to {_lore::*}
        else:
            add "&8[&c&l✖&8] &7%{_desc_meta}% &8(%{_progresso}%/%{_alvo}%)" to {_lore::*}
            
        add 1 to {_index}

    if {entrega_registry::%{_contrato_id}%::npc} is set:
        add "" to {_lore::*}
        add "&f&lᴇɴᴛʀᴇɢᴀs ᴇxɪɢɪᴅᴀs:" to {_lore::*}
        
        loop {entrega_registry::%{_contrato_id}%::requisitos::*}:
            set {_req_parts::*} to loop-value split at "|"
            set {_qtd_req} to {_req_parts::2}
            set {_nome_amigavel} to {_req_parts::3}
            
            if {missao::semanal::%{_p}%::%{_job}%::status} is "aguardando_entrega":
                add "&8[&e&l!&8] &e%{_qtd_req}%x %{_nome_amigavel}%" to {_lore::*}
            else if {missao::semanal::%{_p}%::%{_job}%::status} is "concluida":
                add "&8[&a&l✔&8] &a%{_qtd_req}%x %{_nome_amigavel}%" to {_lore::*}
            else:
                add "&8[&7&l!&8] &7%{_qtd_req}%x %{_nome_amigavel}%" to {_lore::*}
                
        if {missao::semanal::%{_p}%::%{_job}%::status} is "aguardando_entrega":
            set {_npc_id} to {entrega_registry::%{_contrato_id}%::npc}
            set {_npc_nome} to {npc_nome::%{_npc_id}%} ? "NPC"
            add "" to {_lore::*}
            add "&e➡ ʟᴇᴠᴇ ᴏs ᴍᴀᴛᴇʀɪᴀɪs ᴘᴀʀᴀ ᴏ &f%{_npc_nome}% ɴᴀ ᴠɪʟᴀ ᴅᴏs %formatarNomeJob({_job})%s" to {_lore::*}
        else if {missao::semanal::%{_p}%::%{_job}%::status} is "em_andamento":
            add "" to {_lore::*}
            add "&7➡ &oᴄᴏɴᴄʟᴜᴀ ᴀ ᴄᴏʟᴇᴛᴀ ᴘᴀʀᴀ ʟɪʙᴇʀᴀʀ ᴀ ᴇɴᴛʀᴇɢᴀ." to {_lore::*}
            
    add "" to {_lore::*}
    
    set {_money} to {missao::semanal::%{_p}%::%{_job}%::recompensa_dinheiro} ? 100
    add "&eʀᴇᴄᴏᴍᴘᴇɴsᴀ: &a$%{_money}% &e+ &b1x ᴊᴏʙ ᴋᴇʏ" to {_lore::*}
    
    return {_lore::*}

function addProgressoSemanal(p: player, job: text, acao: text, tipo_alvo: text, qtd: number):
    if {missao::semanal::%{_p}%::%{_job}%::status} is "em_andamento":
        set {_index} to 1
        while {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::id} is set:
            set {_meta_id} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::id}
            if {meta_base::%{_meta_id}%::acao} is {_acao}:
                set {_match} to false
                if {meta_base::%{_meta_id}%::tipos::*} contains "any":
                    set {_match} to true
                else:
                    loop {meta_base::%{_meta_id}%::tipos::*}:
                        set {_req} to loop-value
                        if {_tipo_alvo} is {_req}:
                            set {_match} to true
                        else if "%{_tipo_alvo}%" is "%{_req}%s":
                            set {_match} to true
                        else if "%{_req}%" is "%{_tipo_alvo}%s":
                            set {_match} to true
                if {_match} is true:
                    set {_prog_atual} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::progresso}
                    set {_alvo_max} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::alvo}
                    if {_prog_atual} < {_alvo_max}:
                        add {_qtd} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::progresso}
                        set {_prog_novo} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::progresso}
                        set {_nome_curto} to {meta_base::%{_meta_id}%::nome_curto}
                        mostrarProgresso({_p}, "&6&l[SEMANAL] &f%{_nome_curto}%", {_prog_novo}, {_alvo_max})
                        verificarConclusaoSemanal({_p}, {_job})
            add 1 to {_index}

function verificarConclusaoSemanal(p: player, job: text):
    set {_todas_concluidas} to true
    set {_index} to 1
    while {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::id} is set:
        set {_prog} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::progresso}
        set {_alvo} to {missao::semanal::%{_p}%::%{_job}%::meta::%{_index}%::alvo}
        if {_prog} < {_alvo}:
            set {_todas_concluidas} to false
            stop loop
        add 1 to {_index}
        
    if {_todas_concluidas} is true:
        set {_contrato_id} to {missao::semanal::%{_p}%::%{_job}%::id}
        delete {missao::semanal::%{_p}%::%{_job}%::acao_ativa::*}
        
        if {entrega_registry::%{_contrato_id}%::npc} is set:
            set {missao::semanal::%{_p}%::%{_job}%::status} to "aguardando_entrega"
            set {missao::status::%{_contrato_id}%::%uuid of {_p}%} to "aguardando_entrega"
            set {_npc_id} to {entrega_registry::%{_contrato_id}%::npc}
            set {_npc_nome} to {npc_nome::%{_npc_id}%} ? "o NPC responsável"
            play sound "entity.player.levelup" with volume 1.0 and pitch 0.5 to {_p}
            send "" to {_p}
            send "&6&l[CONTRATO SEMANAL] &7Fase de coleta concluída!" to {_p}
            send "&7Vá até a vila e entregue os materiais para &e%{_npc_nome}% (NPC %{_npc_id}%)&7." to {_p}
            send "" to {_p}
        else:
            set {missao::semanal::%{_p}%::%{_job}%::status} to "concluida"
            set {_money} to {missao::semanal::%{_p}%::%{_job}%::recompensa_dinheiro} ? 100
            execute console command "eco give %{_p}% %{_money}%"
            execute console command "crate key give %{_p}% jobkey 1"
            play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 1.0 to {_p}
            send "" to {_p}
            send "&6&l[CONTRATO SEMANAL] &7O contrato '&f%{semanal_meta::%{_contrato_id}%::nome}%&7' foi finalizado!" to {_p}
            send "&a&l+ $%{_money}%" to {_p}
            send "&b&l+ 1x Job Key" to {_p}
            send "" to {_p}

function verificarEntregasSemanais(p: player):
    set {_uuid} to uuid of {_p}
    set {_ativos::*} to getJobsAtivos({_p})
    loop {_ativos::*}:
        set {_job} to loop-value
        if {missao::semanal::%{_p}%::%{_job}%::status} is "aguardando_entrega":
            set {_contrato_id} to {missao::semanal::%{_p}%::%{_job}%::id}
            if {missao::status::%{_contrato_id}%::%{_uuid}%} is "concluida":
                set {missao::semanal::%{_p}%::%{_job}%::status} to "concluida"
                set {_money} to {missao::semanal::%{_p}%::%{_job}%::recompensa_dinheiro} ? 100
                execute console command "eco give %{_p}% %{_money}%"
                execute console command "crate key give %{_p}% jobkey 1"
                send "&a&l+ $%{_money}% &7(Pagamento do Sindicato)" to {_p}
                send "&b&l+ 1x Job Key &7(Bônus de Contrato Semanal)" to {_p}

function processarProgressoSnapshot(p: player, click: text, tipo: item type, qtd_evento: integer, job: text, acao: text, alvo_str: text):
    set {_processar} to false
    set {_forjado} to 0
    set {_id_missao} to {diaria::%{_job}%::%uuid of {_p}%::tarefa}

    if {_click} is "left mouse button", "drop key" or "drop key with control":
        set {_forjado} to {_qtd_evento}
        set {_processar} to true
    else if {_click} is "right mouse button":
        set {_forjado} to {_qtd_evento} / 2
        set {_forjado} to rounded up {_forjado}
        set {_processar} to true
    else if {_click} is "left mouse button with shift", "right mouse button with shift" or "number key":
        set {_antes} to amount of {_tipo} in {_p}'s inventory
        wait 1 tick
        set {_depois} to amount of {_tipo} in {_p}'s inventory
        set {_forjado} to {_depois} - {_antes}
        set {_processar} to true
        
    if {_processar} is true:
        if {_forjado} > 0:
            addProgressoSemanal({_p}, {_job}, {_acao}, {_alvo_str}, {_forjado})
            if {diaria_meta::%{_id_missao}%::alvo_tipos::*} contains {_tipo}:
                addProgressoDiaria({_p}, {_job}, {_id_missao}, {_forjado})
                broadcast {_p}, {_job}, {_id_missao}, {_forjado}
# ========================================================================
# OUVINTES UNIVERSAIS E MOTOR DE PROGRESSO 
# ========================================================================
on right click on dirt or grass block with wooden hoe, stone hoe, iron hoe, golden hoe, diamond hoe or netherite hoe:
    if {missao::semanal::%player%::fazendeiro::acao_ativa::arar} is true:
        addProgressoSemanal(player, "fazendeiro", "arar", "%type of event-block%", 1)

on breeding:
    if breeder is set:
        if {missao::semanal::%breeder%::fazendeiro::acao_ativa::procriar} is true:
            addProgressoSemanal(breeder, "fazendeiro", "procriar", "%type of event-entity%", 1)

on right click on sheep with shears:
    if {missao::semanal::%player%::fazendeiro::acao_ativa::tosar} is true:
        if target entity is not sheared:
            addProgressoSemanal(player, "fazendeiro", "tosar", "sheep", 1)

on right click on sweet berry bush, cave vines, cave vines plant, bee nest or beehive:
    if {missao::semanal::%player%::fazendeiro::acao_ativa::coletar} is true:
        if event-block is sweet berry bush:
            if "%block data of event-block%" contains "age=3":
                addProgressoSemanal(player, "fazendeiro", "coletar", "sweet berries", 1)
        else if event-block is cave vines or cave vines plant:
            if "%block data of event-block%" contains "berries=true":
                addProgressoSemanal(player, "fazendeiro", "coletar", "glow berries", 1)
        else if event-block is bee nest or beehive:
            if "%block data of event-block%" contains "honey_level=5":
                if player's tool is glass bottle:
                    addProgressoSemanal(player, "fazendeiro", "coletar", "honey bottle", 1)

on tool break:
    if {missao::semanal::%player%::minerador::acao_ativa::quebrar_ferramenta} is true:
        addProgressoSemanal(player, "minerador", "quebrar_ferramenta", "%type of event-item%", 1)
    if {missao::semanal::%player%::lenhador::acao_ativa::quebrar_ferramenta} is true:
        addProgressoSemanal(player, "lenhador", "quebrar_ferramenta", "%type of event-item%", 1)

on inventory click:
    if {missao::semanal::%player%::minerador::acao_ativa::fundir} is true:
        if event-inventory's type is furnace inventory or blast furnace inventory:
            if index of event-slot is 2:
                if event-item is not air:
                    processarProgressoSnapshot(player, "%click type%", type of event-item, item amount of event-item, "minerador", "fundir", "%type of event-item%")
                    
    if {missao::semanal::%player%::minerador::acao_ativa::forjar} is true:
        if event-inventory's type is smithing inventory:
            if index of event-slot is 3:
                if event-item is not air:
                    processarProgressoSnapshot(player, "%click type%", type of event-item, item amount of event-item, "minerador", "forjar", "%type of event-item%")
                    
    if {missao::semanal::%player%::mago::acao_ativa::fundir_bigorna} is true:
        if event-inventory's type is anvil inventory:
            if index of event-slot is 2:
                if event-item is not air:
                    addProgressoSemanal(player, "mago", "fundir_bigorna", "any", 1)
                    
    if {missao::semanal::%player%::mago::acao_ativa::desencantar} is true:
        if event-inventory's type is grindstone inventory:
            if index of event-slot is 2:
                if event-item is not air:
                    addProgressoSemanal(player, "mago", "desencantar", "any", 1)
                    
    if {missao::semanal::%player%::mago::acao_ativa::comprar_aldeao} is true:
        if event-inventory's type is merchant inventory:
            if index of event-slot is 2:
                if event-item is enchanted book:
                    addProgressoSemanal(player, "mago", "comprar_aldeao", "enchanted book", 1)

on enchant:
    if {missao::semanal::%player%::mago::acao_ativa::encantar} is true:
        set {_ativo} to true
    else if {missao::semanal::%player%::mago::acao_ativa::encantar_nv30} is true:
        set {_ativo} to true
        
    if {_ativo} is true:
        addProgressoSemanal(player, "mago", "encantar", "%type of event-item%", 1)
        addProgressoSemanal(player, "mago", "encantar", "any", 1)
        set {_xp_antes} to player's level
        wait 1 tick
        set {_xp_depois} to player's level
        if ({_xp_antes} - {_xp_depois}) is 3:
            addProgressoSemanal(player, "mago", "encantar_nv30", "any", 1)

on mine:
    if metadata "desertsky_placed" of event-block is true:
        stop
    set {_tipo} to "%type of event-block%"

    if {missao::semanal::%player%::construtor::acao_ativa::construir} is true:
        addProgressoSemanal(player, "construtor", "construir", {_tipo}, -1)
    if {missao::semanal::%player%::lenhador::acao_ativa::plantar} is true:
        addProgressoSemanal(player, "lenhador", "plantar", {_tipo}, -1)
    if {missao::semanal::%player%::lenhador::acao_ativa::minerar} is true:
        addProgressoSemanal(player, "lenhador", "minerar", {_tipo}, 1)

    if {missao::semanal::%player%::fazendeiro::acao_ativa::minerar} is true:
        set {_valido} to true
        set {_data} to "%block data of event-block%"
        if {_tipo} contains "wheat":
            if {_data} does not contain "age=7":
                set {_valido} to false
        else if {_tipo} contains "carrots" or "carrot":
            if {_data} does not contain "age=7":
                set {_valido} to false
        else if {_tipo} contains "beetroots" or "beetroot":
            if {_data} does not contain "age=3":
                set {_valido} to false
        else if {_tipo} contains "potatoes" or "potato":
            if {_data} does not contain "age=7":
                set {_valido} to false
        else if {_tipo} contains "nether wart":
            if {_data} does not contain "age=3":
                set {_valido} to false
        else if {_tipo} contains "cocoa":
            if {_data} does not contain "age=2":
                set {_valido} to false
        if {_valido} is true:
            addProgressoSemanal(player, "fazendeiro", "minerar", {_tipo}, 1)
            
    if {missao::semanal::%player%::minerador::acao_ativa::minerar} is true:
        addProgressoSemanal(player, "minerador", "minerar", {_tipo}, 1)
        if {_tipo} is "sugar cane", "pumpkin" or "melon":
            addProgressoSemanal(player, "minerador", "minerar", {_tipo}, 1)
            
    if {missao::semanal::%player%::escavador::acao_ativa::minerar} is true:
        addProgressoSemanal(player, "escavador", "minerar", {_tipo}, 1)
    if {missao::semanal::%player%::bruxo::acao_ativa::minerar} is true:
        addProgressoSemanal(player, "bruxo", "minerar", {_tipo}, 1)

on bucket fill:
    if {missao::semanal::%player%::minerador::acao_ativa::coletar} is true:
        if event-block is lava:
            addProgressoSemanal(player, "minerador", "coletar", "lava bucket", 1)

on right click on suspicious sand or suspicious gravel with brush:
    if {missao::semanal::%player%::escavador::acao_ativa::escovar} is true:
        set {_loc} to location of event-block
        if {brush_loop::%{_loc}%} is set:
            stop
        set {brush_loop::%{_loc}%} to true
        set {_p} to player
        set {_tipo_original} to type of event-block
        while block at {_loc} is suspicious sand or suspicious gravel:
            wait 5 ticks
            if {_p} is offline:
                delete {brush_loop::%{_loc}%}
                stop
            if world of {_p} is not world of {_loc}:
                delete {brush_loop::%{_loc}%}
                stop
            if distance between location of {_p} and {_loc} > 10:
                delete {brush_loop::%{_loc}%}
                stop
        if block at {_loc} is sand or gravel:
            if {missao::semanal::%{_p}%::escavador::acao_ativa::escovar} is true:
                set {_nome_tipo} to "suspicious sand"
                if {_tipo_original} is suspicious gravel:
                    set {_nome_tipo} to "suspicious gravel"
                addProgressoSemanal({_p}, "escavador", "escovar", {_nome_tipo}, 1)
        delete {brush_loop::%{_loc}%}

on fishing state change:
    if {missao::semanal::%player%::pescador::acao_ativa::pescar} is true:
        if "%fishing state%" is "fish caught":
            set {_ent} to fishing caught entity
            if {_ent} is set:
                set {_item} to item of {_ent}
                set {_tipo} to "%type of {_item}%"
                if {_tipo} is "<none>":
                    set {_tipo} to "%{_ent}%"
                addProgressoSemanal(player, "pescador", "pescar", {_tipo}, 1)

on consume:
    if {missao::semanal::%player%::pescador::acao_ativa::comer} is true:
        addProgressoSemanal(player, "pescador", "comer", "%type of event-item%", 1)

on craft:
    if {missao::semanal::%player%::job::acao_ativa::craftar} is true:
        processarProgressoSnapshot(player, "%click type%", type of event-item, item amount of event-item, "job", "craftar", "%type of event-item%")

on right click on grass block, dirt, podzol, coarse dirt or rooted dirt with wooden shovel, stone shovel, iron shovel, golden shovel, diamond shovel or netherite shovel:
    if {missao::semanal::%player%::escavador::acao_ativa::achatar} is true:
        addProgressoSemanal(player, "escavador", "achatar", "dirt path", 1)

on place:
    set metadata "desertsky_placed" of event-block to true
    set {_tipo} to "%type of event-block%"
    if {missao::semanal::%player%::construtor::acao_ativa::construir} is true:
        addProgressoSemanal(player, "construtor", "construir", {_tipo}, 1)
    if {missao::semanal::%player%::lenhador::acao_ativa::construir} is true:
        addProgressoSemanal(player, "lenhador", "construir", {_tipo}, 1)
    if {missao::semanal::%player%::lenhador::acao_ativa::plantar} is true:
        addProgressoSemanal(player, "lenhador", "plantar", {_tipo}, 1)
    if {missao::semanal::%player%::fazendeiro::acao_ativa::plantar} is true:
        addProgressoSemanal(player, "fazendeiro", "plantar", {_tipo}, 1)

on death:
    if attacker is a player:
        if {missao::semanal::%attacker%::bruxo::acao_ativa::matar} is true:
            addProgressoSemanal(attacker, "bruxo", "matar", "%type of victim%", 1)