# =============================================================================
# DESERTSKY - CORE PRINCIPAL (V5.2 - ARQUITETURA BLINDADA & API DE EMPREGOS)
# Caminho: /plugins/Skript/scripts/Jobs/core/Core.sk
# =============================================================================

on script load:
    set {DS_Server_Ready} to false
    send "&e[DesertSky-Core] &fA aguardar carregamento de variáveis..." to console
    wait 15 seconds
    set {DS_Server_Ready} to true
    send "&a[DesertSky-Core] &fSistema pronto e variáveis carregadas." to console

# =============================================================================
# DEFESA GLOBAL ANTI-CHEAT E EVENTOS NATIVOS JOBSSK
# =============================================================================
on place:
    set metadata "desertsky_placed" of event-block to true

# [GATILHO DE DEMISSÃO NATIVO] O Cão de Guarda do Sistema!
# Dispara sempre que o jogador sai de um job (via GUI, Admin ou Consola)
on player leave job:
    set {_job} to "%event-job%" in lowercase
    set {_uuid} to uuid of player
    
    # Limpeza absoluta do histórico da profissão perdida
    delete {nivel::%{_job}%::%{_uuid}%}
    delete {diaria::%{_job}%::%{_uuid}%::*}
    delete {missao::semanal::%player%::%{_job}%::*}
    
    send "&c&l[SINDICATO] &7O teu contrato como &f%{_job}% &7foi rescindido e os registos apagados." to player

# --- 1. GLOBAL REGISTRY (MECÂNICA DE HERANÇA OTIMIZADA) ---
function registrarMissao(id: integer, job: text, min_level: integer, nome: text, lore: text, desc: text):
    if {registry::missao::%{_job}%::%{_id}%::job} is not {_job}:
        set {registry::missao::%{_job}%::%{_id}%::job} to {_job}
    if {registry::missao::%{_job}%::%{_id}%::min_level} is not {_min_level}:
        set {registry::missao::%{_job}%::%{_id}%::min_level} to {_min_level}
    if {registry::missao::%{_job}%::%{_id}%::nome} is not {_nome}:
        set {registry::missao::%{_job}%::%{_id}%::nome} to {_nome}
    if {registry::missao::%{_job}%::%{_id}%::lore} is not {_lore}:
        set {registry::missao::%{_job}%::%{_id}%::lore} to {_lore}
    if {registry::missao::%{_job}%::%{_id}%::desc} is not {_desc}:
        set {registry::missao::%{_job}%::%{_id}%::desc} to {_desc}
    
    if {registry::missoes::%{_job}%::lista::*} does not contain {_id}:
        add {_id} to {registry::missoes::%{_job}%::lista::*}

# --- 2. FUNÇÕES TÉCNICAS (ESTRATÉGIA DO ADAPTADOR) ---
function checkJob(p: player, job: text) :: boolean:
    set {_jobs_lista::*} to jobs of {_p}
    loop {_jobs_lista::*}:
        if "%loop-value%" in lowercase is {_job}:
            return true
    return false

function getStatusMissao(p: player, id: integer) :: text:
    set {_status} to {missao::status::%{_id}%::%uuid of {_p}%}
    if {_status} is not set:
        return "disponivel"
    return {_status}

# --- 3. SISTEMA DE LAZY RESET (ANTI-LAG) ---
on join:
    set {_hoje} to now formatted as "dd/MM/yyyy"
    set {_uuid} to uuid of player
    if {last_reset::%{_uuid}%} is not {_hoje}:
        set {last_reset::%{_uuid}%} to {_hoje}
        send "&6&l[DIÁRIO] &7Um novo dia amanheceu no deserto. Suas tarefas diárias foram atualizadas." to player

# --- 4. HIGIENE E PREVENÇÃO DE MEMORY LEAKS ---
on quit:
    delete {temp_progresso::%uuid of player%}

on script load:
    delete {registry::missoes::lista::*}

# --- 5. ACTION BAR ENGINE (MOTOR VISUAL) ---
function mostrarProgresso(p: player, titulo: text, atual: number, meta: number):
    if {_meta} <= 0:
        set {_meta} to 1
    if {_atual} > {_meta}:
        set {_atual} to {_meta}
        
    set {_porcentagem} to ({_atual} / {_meta})
    set {_barras_verdes} to round({_porcentagem} * 10)
    set {_barras_cinzas} to 10 - {_barras_verdes}
    
    set {_bar_string} to ""
    loop {_barras_verdes} times:
        set {_bar_string} to "%{_bar_string}%&a|"
    loop {_barras_cinzas} times:
        set {_bar_string} to "%{_bar_string}%&7|"
        
    set {_atual_format} to round({_atual})
    set {_meta_format} to round({_meta})
    
    send action bar "&6&l%{_titulo}% &8[&f%{_bar_string}%&8] &e%{_atual_format}%&6/&e%{_meta_format}%" to {_p}

# --- 6. FUNÇÃO DE CONCLUSÃO PADRÃO ---
function concluirMissaoPrincipal(p: player, id: integer, job: text, proximo_nivel: integer):
    set {_uuid} to uuid of {_p}
    
    set {missao::%{_job}%::%{_id}%::%{_uuid}%::status} to "concluida"
    setNivelJob({_p}, {_job}, {_proximo_nivel})
    
    if {_job} is "explorador":
        set {nivel::%{_uuid}%} to {_proximo_nivel}
        set {missao::status::%{_id}%::%{_uuid}%} to "concluida"
        
    play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 1.0 to {_p}
    send title "&a&lMISSÃO CONCLUÍDA!" with subtitle "&7Avançaste para o Nível %{_proximo_nivel}%." to {_p} for 4 seconds
    send "" to {_p}
    send "&e&l[DIÁRIO] &7A Missão %{_id}% da linhagem %{_job}% foi concluída!" to {_p}
    send "&e&l[DIÁRIO] &7Usa &f/diario &7para visualizar o teu próximo objetivo." to {_p}
    send "" to {_p}

# =============================================================================
# --- 7. API DE NÍVEIS E PROFISSÕES (SISTEMA DE CONTRATAÇÃO BLINDADO) ---
# =============================================================================

function getJobsAtivos(p: player) :: strings:
    set {_jobs_lista::*} to jobs of {_p}
    set {_ativos::*} to "explorador"
    loop {_jobs_lista::*}:
        add "%loop-value%" in lowercase to {_ativos::*}
    return {_ativos::*}

function getNivelJob(p: player, job: text) :: integer:
    set {_uuid} to uuid of {_p}
    if {nivel::%{_job}%::%{_uuid}%} is not set:
        return 1
    return {nivel::%{_job}%::%{_uuid}%}

function setNivelJob(p: player, job: text, nivel: integer):
    set {_uuid} to uuid of {_p}
    set {nivel::%{_job}%::%{_uuid}%} to {_nivel}
    set level of job {_job} of {_p} to {_nivel}

function demitirJob(p: player, job: text):
    # Apenas envia o comando para o backend. O Skript cuida da limpeza via 'on player leave job'
    execute console command "jobs fire %{_p}% %{_job}%"

# [NOVO] Lógica centralizada de Contratação e Verificação de Requisitos
function tentarContratarJogador(p: player, escolha: text):
    set {_uuid} to uuid of {_p}
    set {_nivel_atual} to {nivel::%{_uuid}%} ? 1

    set {_tier2::*} to "minerador", "lenhador", "escavador", "pescador" and "fazendeiro"
    set {_tier3::*} to "bruxo", "construtor" and "mago"

    # --- VERIFICAÇÃO TIER 2 ---
    if {_tier2::*} contains {_escolha}:
        if {_nivel_atual} < 20:
            send "&c[!] Anomalia detetada! O teu nível de Explorador (%{_nivel_atual}%) é insuficiente." to {_p}
            send "&c[!] Precisas de concluir a Missão 20 para escolheres uma especialização." to {_p}
            play sound "entity.villager.no" to {_p}
            close {_p}'s inventory
            stop
            
        if {_nivel_atual} is 20:
            set {missao::20::%{_uuid}%::status} to "concluida"
            set {nivel::%{_uuid}%} to 21 
            
        execute console command "jobs employ %{_p}% %{_escolha}%"
        
        send title "&6&lNOVO DESTINO" with subtitle "&eTornaste-te num %{_escolha}%!" to {_p} for 5 seconds
        play sound "ui.toast.challenge_complete" to {_p}
        send "" to {_p}
        send "&e&l[!] &7O Diário de Sobrevivência Inicial foi concluído." to {_p}
        send "&e&l[!] &7O teu nome será lembrado como um verdadeiro &f%{_escolha}%&7!" to {_p}
        send "" to {_p}
        close {_p}'s inventory
        stop

    # --- VERIFICAÇÃO TIER 3 ---
    if {_tier3::*} contains {_escolha}:
        if {_nivel_atual} < 40: 
            send "&c[!] Acesso Negado! Precisas de ser Nível 40 de Explorador." to {_p}
            play sound "entity.villager.no" to {_p}
            close {_p}'s inventory
            stop
            
        set {_meu_tier2} to ""
        set {_jobs_ativos::*} to getJobsAtivos({_p})
        
        loop {_tier2::*}:
            if {_jobs_ativos::*} contains loop-value:
                set {_meu_tier2} to loop-value
                stop loop
                
        if {_meu_tier2} is "":
            send "&c[!] Precisas de escolher uma especialidade (Tier 2) primeiro!" to {_p}
            play sound "entity.villager.no" to {_p}
            close {_p}'s inventory
            stop
            
        set {_nivel_t2} to getNivelJob({_p}, {_meu_tier2})
        if {_nivel_t2} < 50:
            send "&c[!] Precisas de evoluir %{_meu_tier2}% até o nível 50 primeiro!" to {_p}
            play sound "entity.villager.no" to {_p}
            close {_p}'s inventory
            stop
        
        execute console command "jobs employ %{_p}% %{_escolha}%"
        
        send title "&5&lMESTRIA ALCANÇADA" with subtitle "&dAgora dominas os caminhos do %{_escolha}%!" to {_p} for 5 seconds
        play sound "ui.toast.challenge_complete" to {_p}
        close {_p}'s inventory
        stop

# =============================================================================
# COMANDOS PONTE (USADOS PELOS MENUS GUIs)
# =============================================================================
command /desertsky_admin_setjob <text> <text>:
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is set:
            tentarContratarJogador({_p}, arg-2)

command /desertsky_admin_firejob <text> <text>:
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is set:
            demitirJob({_p}, arg-2)

# =============================================================================
# --- FORMATADORES VISUAIS ---
# =============================================================================
function formatarNomeJob(job: text) :: text:
    if {_job} is "explorador":
        return "<#ff5555>ᴇxᴘʟᴏʀᴀᴅᴏʀ"
    else if {_job} is "minerador":
        return "<#ffcc00>ᴍɪɴᴇʀᴀᴅᴏʀ"
    else if {_job} is "lenhador":
        return "<#883300>ʟᴇɴʜᴀᴅᴏʀ"
    else if {_job} is "escavador":
        return "<#ff7744>ᴇsᴄᴀᴠᴀᴅᴏʀ"
    else if {_job} is "fazendeiro":
        return "<#00cc22>ꜰᴀᴢᴇɴᴅᴇɪʀᴏ"
    else if {_job} is "pescador":
        return "<#0077ff>ᴘᴇsᴄᴀᴅᴏʀ"
    else if {_job} is "construtor":
        return "<#00cccc>ᴄᴏɴsᴛʀᴜᴛᴏʀ"
    else if {_job} is "bruxo":
        return "<#ccff22>ʙʀᴜxᴏ"
    else if {_job} is "mago":
        return "<#ff3399>ᴍᴀɢᴏ"
    return "&7&l%{_job}%"

function getJobPorTier(p: player, tier: integer) :: text:
    set {_ativos::*} to getJobsAtivos({_p})
    
    if {_tier} is 1:
        set {_tier_jobs::*} to "explorador"
    else if {_tier} is 2:
        set {_tier_jobs::*} to "minerador", "lenhador", "escavador", "fazendeiro", "pescador" and "construtor"
    else if {_tier} is 3:
        set {_tier_jobs::*} to "bruxo" and "mago"
        
    loop {_ativos::*}:
        if {_tier_jobs::*} contains loop-value:
            return formatarNomeJob(loop-value)
            
    return "&8&lɴᴀᴏ ᴇsᴄᴏʟʜɪᴅᴏ"